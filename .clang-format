---
# Language: None, Cpp, Java, JavaScript, ObjC, Proto, TableGen, TextProto
Language:        Cpp
# BasedOnStyle:  Google
# Offset of access specifiers (public/protected/private)
AccessModifierOffset: -1
# Alignment after an open bracket (parenthesis/angle bracket/square bracket): Align, DontAlign, AlwaysBreak (always break after the open bracket)
AlignAfterOpenBracket: Align
# Alignment of consecutive macro definitions
AlignConsecutiveMacros: false
# Align the equals signs of consecutive assignments
AlignConsecutiveAssignments: true
# Alignment of consecutive bit fields
AlignConsecutiveBitFields: false
# Alignment of variable names in consecutive declarations
AlignConsecutiveDeclarations: false
# Alignment of backslashes in escaped newlines: DontAlign, Left, Right
AlignEscapedNewlines: Left
# Alignment of binary/ternary expression operands that span several lines: DontAlign, Align, AlignAfterOperator
AlignOperands:   Align
# Align trailing comments
AlignTrailingComments: true
# Allow all arguments of a function call to go on the next line when they do not fit on one line
AllowAllArgumentsOnNextLine: true
# Allow all constructor initializers to go on the next line when they do not fit on one line
# Note: only effective when ConstructorInitializerAllOnOneLineOrOnePerLine is true
AllowAllConstructorInitializersOnNextLine: true
# Allow all parameters of a function declaration to go on the next line when they do not fit on one line
AllowAllParametersOfDeclarationOnNextLine: true
# Allow short enums on a single line
AllowShortEnumsOnASingleLine: false
# Allow short blocks on a single line: Never, Empty, Always
AllowShortBlocksOnASingleLine: Never
# Allow short case labels and statements on a single line
AllowShortCaseLabelsOnASingleLine: false
# Allow short functions on a single line: None, InlineOnly, Empty, Inline, All
AllowShortFunctionsOnASingleLine: None
# Allow short lambdas on a single line: None, Empty, Inline, All
AllowShortLambdasOnASingleLine: All
# Allow short if statements on a single line: Never, WithoutElse, OnlyFirstIf, AllIfAndElse
AllowShortIfStatementsOnASingleLine: false
# Allow short loops on a single line
AllowShortLoopsOnASingleLine: false
# Break after the return type of function definitions:
# None (decided by PenaltyReturnTypeOnItsOwnLine)
# All (always break after the return type)
# TopLevel (break after the return type of top-level function definitions only)
AlwaysBreakAfterDefinitionReturnType: None
# Break after the return type of function declarations/definitions:
# None (decided by PenaltyReturnTypeOnItsOwnLine)
# All (always break after the return type)
# TopLevel (break after the return type of top-level function declarations/definitions only)
# AllDefinitions (break after the return type of all function definitions)
# TopLevelDefinitions (break after the return type of top-level function definitions only)
AlwaysBreakAfterReturnType: None
# Always break before multiline strings
AlwaysBreakBeforeMultilineStrings: true
# Break after template declarations:
# None (controlled by PenaltyBreakTemplateDeclaration)
# MultiLine (break only when the template declaration spans several lines)
# Yes (always break)
AlwaysBreakTemplateDeclarations: Yes
# Placement of function call arguments
# false (arguments are either all on one line or one per line, aligned)
# true (no requirement)
BinPackArguments: false
# Placement of function declaration/definition parameters
# false (parameters are either all on one line or one per line, aligned)
# true (no requirement)
BinPackParameters: false
# Brace wrapping, only effective when BreakBeforeBraces is Custom
BraceWrapping:
  # Break after a case label
  AfterCaseLabel:  true
  # Break after a class definition
  AfterClass:      true
  # Break after a control statement
  AfterControlStatement: true
  # Break after an enum definition
  AfterEnum:       true
  # Break after a function definition
  AfterFunction:   true
  # Break after a namespace definition
  AfterNamespace:  true
  # Break after an ObjC definition
  AfterObjCDeclaration: true
  # Break after a struct definition
  AfterStruct:     true
  # Break after a union definition
  AfterUnion:      true
  # Break after extern
  AfterExternBlock: false
  # Break before catch
  BeforeCatch:     true
  # Break before else
  BeforeElse:      true
  # Break before the body of a lambda expression
  BeforeLambdaBody: false
  # Break before the while of a do-while
  BeforeWhile:     false
  # Indent the braces
  IndentBraces:    false
  # Put the braces of an empty function on two lines
  SplitEmptyFunction: true
  # Put the braces of an empty class/struct/union on two lines
  SplitEmptyRecord: true
  # Put the braces of an empty namespace on two lines
  SplitEmptyNamespace: true
# Line breaks in binary expressions: None (break after operators), NonAssignment (break before non-assignment operators), All (break before operators)
BreakBeforeBinaryOperators: None
# Break before braces:
# Attach (always attach braces to the surrounding context)
# Linux (like Attach, but put the braces of function/namespace/class definitions on the next line)
# Mozilla (like Attach, but put the braces of enum/function/struct definitions on the next line)
# Stroustrup (like Attach, but break before function definitions, catch and else)
# Allman (always break before braces)
# GNU (always break before braces, and indent the braces after control statements)
# WebKit (like Attach, but break before function definitions)
# Custom (use BraceWrapping)
BreakBeforeBraces: Custom
# Break before the commas of a class inheritance list
BreakBeforeInheritanceComma: false
# How to split a class inheritance list: BeforeColon, BeforeComma, AfterColon, AfterComma
BreakInheritanceList: BeforeColon
# Break before ternary operators when a ternary expression does not fit on one line
BreakBeforeTernaryOperators: true
# Break before the commas of a constructor initializer list
BreakConstructorInitializersBeforeComma: false
# Line breaks in constructor initializer lists: BeforeColon, BeforeComma, AfterColon
BreakConstructorInitializers: BeforeColon
# Break after Java field annotations
BreakAfterJavaFieldAnnotations: false
# Break string literals that are too long
BreakStringLiterals: true
# Column limit, 0 means no limit; 120 works well
ColumnLimit:     120
# Regular expression for comments with a special meaning, which must not be split or otherwise changed
CommentPragmas:  '^ IWYU pragma:'
# Put consecutive namespace declarations on the same line
CompactNamespaces: false
# Constructor initializers either all on one line or one per line
ConstructorInitializerAllOnOneLineOrOnePerLine: true
# Indent width of constructor initializer lists and inheritance lists
ConstructorInitializerIndentWidth: 4
# Indent width of continuation lines
ContinuationIndentWidth: 4
# C++11 braced list style
Cpp11BracedListStyle: true
# Derive the line ending: true (analyze the line endings of the file, use UseCRLF if they cannot be determined), false (do not analyze)
DeriveLineEnding: true
# Derive the most common pointer and reference alignment
DerivePointerAlignment: false
# Disable formatting
DisableFormat:   false
# Experimental automatic detection of the bin packing style
ExperimentalAutoDetectBinPacking: false
# Fix namespace end comments
FixNamespaceComments: true
# Macros that should be treated as foreach loops instead of function calls
ForEachMacros:
  - foreach
  - Q_FOREACH
  - BOOST_FOREACH
# Grouping rule when sorting several include blocks (includes separated by blank lines):
# Preserve (keep the blocks and sort each one)
# Merge (merge all blocks and sort them together)
# Regroup (merge all blocks and sort them by IncludeCategories)
IncludeBlocks:   Regroup
# Include sorting rules
IncludeCategories:
  - Regex:           '^<ext/.*\.h>'
    Priority:        2
    SortPriority:    0
  - Regex:           '^<.*\.h>'
    Priority:        1
    SortPriority:    0
  - Regex:           '^<.*'
    Priority:        2
    SortPriority:    0
  - Regex:           '.*'
    Priority:        3
    SortPriority:    0
IncludeIsMainRegex: '([-_](test|unittest))?$'
IncludeIsMainSourceRegex: ''
# Indent case labels
IndentCaseLabels: true
# Indent case blocks
IndentCaseBlocks: true
# Indent goto labels
IndentGotoLabels: true
# Indentation of preprocessor directives (#if/#ifdef/#endif...): None, AfterHash (keep # in the first column and indent after it), BeforeHash (indent before #)
IndentPPDirectives: None
# Indentation of extern blocks: AfterExternBlock, NoIndent, Indent
IndentExternBlock: AfterExternBlock
# Indent width
IndentWidth:     4
# Indent wrapped function names that are too long
IndentWrappedFunctionNames: false
# JavaScript only, must be None
InsertTrailingCommas: None
# Quotes for JavaScript strings: Leave (keep as is), Single (single quotes), Double (double quotes)
JavaScriptQuotes: Leave
# Break after JavaScript import/export statements
JavaScriptWrapImports: true
# Keep empty lines at the start of blocks
KeepEmptyLinesAtTheStartOfBlocks: false
# Regular expression that matches the start of a macro block
MacroBlockBegin: ''
# Regular expression that matches the end of a macro block
MacroBlockEnd:   ''
# Maximum number of consecutive empty lines to keep
MaxEmptyLinesToKeep: 1
# Indentation inside namespaces: None, Inner, All
NamespaceIndentation: None
# Objective-C settings
ObjCBinPackProtocolList: Never
ObjCBlockIndentWidth: 2
ObjCBreakBeforeNestedBlockParam: true
ObjCSpaceAfterProperty: false
ObjCSpaceBeforeProtocolList: true
PenaltyBreakAssignment: 2
PenaltyBreakBeforeFirstCallParameter: 1
# Penalty for each line break introduced inside a comment
PenaltyBreakComment: 300
PenaltyBreakFirstLessLess: 120
PenaltyBreakString: 1000
PenaltyBreakTemplateDeclaration: 10
PenaltyExcessCharacter: 1000000
PenaltyReturnTypeOnItsOwnLine: 200
# Pointer and reference alignment: Left, Right, Middle; used when DerivePointerAlignment is off
PointerAlignment: Right
RawStringFormats:
  - Language:        Cpp
    Delimiters:
      - cc
      - CC
      - cpp
      - Cpp
      - CPP
      - 'c++'
      - 'C++'
    CanonicalDelimiter: ''
    BasedOnStyle:    google
  - Language:        TextProto
    Delimiters:
      - pb
      - PB
      - proto
      - PROTO
    EnclosingFunctions:
      - EqualsProto
      - EquivToProto
      - PARSE_PARTIAL_TEXT_PROTO
      - PARSE_TEST_PROTO
      - PARSE_TEXT_PROTO
      - ParseTextOrDie
      - ParseTextProtoOrDie
      - ParseTestProto
      - ParsePartialTestProto
    CanonicalDelimiter: ''
    BasedOnStyle:    google
# Reflow comments
ReflowComments:  true
# Sort all #include lines
SortIncludes:    true
# Sort all using declarations
SortUsingDeclarations: true
# Add a space after a C-style cast
SpaceAfterCStyleCast: false
# Add a space after a logical not
SpaceAfterLogicalNot: false
# Add a space after the template keyword
SpaceAfterTemplateKeyword: true
# Add a space before assignment operators
SpaceBeforeAssignmentOperators: true
# Add a space before a C++11 braced list
SpaceBeforeCpp11BracedList: false
# Add a space before the colon of a constructor initializer
SpaceBeforeCtorInitializerColon: true
# Add a space before the inheritance colon of a class
SpaceBeforeInheritanceColon: true
# Add a space before parentheses: Never, ControlStatements (for/if/while...), Always
SpaceBeforeParens: ControlStatements
# Add a space before the colon of a range-based for loop
SpaceBeforeRangeBasedForLoopColon: true
# Add a space inside an empty block {}
SpaceInEmptyBlock: true
# Add a space inside empty parentheses
SpaceInEmptyParentheses: false
# Number of spaces before trailing comments (only applies to //)
SpacesBeforeTrailingComments: 1
# Add spaces inside angle brackets
SpacesInAngles:  false
# Add spaces inside the parentheses of conditional statements (if/for/switch/while)
SpacesInConditionalStatement: false
# Add spaces inside container literals (ObjC and JavaScript arrays, dictionaries, etc.)
SpacesInContainerLiterals: true
# Add spaces inside the parentheses of a C-style cast
SpacesInCStyleCastParentheses: false
# Add spaces inside parentheses
SpacesInParentheses: false
# Add spaces inside square brackets; lambdas and declarations of arrays without a size are not affected
SpacesInSquareBrackets: false
# Add a space before square brackets; lambdas and declarations of arrays without a size are not affected
SpaceBeforeSquareBrackets: false
# Spacing around the colon of bit fields: Both, None, Before, After
BitFieldColonSpacing: Both
# Standard: Cpp03, Cpp11, Auto
Standard:        Auto
# Macros that are treated as complete statements
StatementMacros:
  - Q_UNUSED
  - QT_REQUIRE_VERSION
# Tab width, 4 spaces
TabWidth:        4
# Use "\r\n" as the line ending
UseCRLF:         false
# Use tab characters: Never, ForIndentation, ForContinuationAndIndentation, Always
UseTab:          Never
# Whitespace-sensitive macros that must not be changed
WhitespaceSensitiveMacros:
  - STRINGIZE
  - PP_STRINGIZE
  - BOOST_PP_STRINGIZE
...

